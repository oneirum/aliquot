{
  "name": "aliquot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/studio",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "slice1": "node scripts/slice1.ts",
    "unit3": "node scripts/unit3.ts",
    "lab0": "node scripts/lab0.ts",
    "walk:router": "node scripts/walk-router.ts",
    "walk:keys": "node scripts/walk-keys.ts",
    "walk:signon": "node scripts/walk-signon.ts",
    "walk:study": "node scripts/walk-study.ts",
    "trust": "node scripts/trust.ts",
    "walk:sources": "node scripts/walk-sources.ts",
    "walk:data": "node scripts/walk-data.ts",
    "unit2": "node scripts/unit2.ts",
    "demo": "node scripts/demo.ts",
    "doctor": "node scripts/doctor.ts",
    "review-pack": "node scripts/review-pack.ts",
    "aliquot": "node --disable-warning=ExperimentalWarning --permission --allow-fs-read=* --allow-net packages/core/bin/aliquot.ts",
    "sources": "node --disable-warning=ExperimentalWarning --permission --allow-fs-read=* --allow-net packages/core/bin/kb.ts sync",
    "aliquot:init": "mkdir -p config && node --disable-warning=ExperimentalWarning --permission --allow-fs-read=* --allow-net --allow-fs-write=config/lab.toml --allow-fs-write=.env packages/core/bin/aliquot.ts init",
    "aliquot:export": "mkdir -p bundles && node --disable-warning=ExperimentalWarning --permission --allow-fs-read=* --allow-net '--allow-fs-write=bundles/*' packages/core/bin/aliquot.ts export",
    "demo:agent": "node scripts/agent-demo.ts",
    "walk:policy": "node scripts/walk-policy.ts",
    "walk:dua": "node scripts/walk-dua.ts",
    "presets:table": "node scripts/presets-table.ts",
    "up:tmux": "scripts/tmux.sh"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.15.5",
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "deepmerge": "file:./vendor/deepmerge"
    }
  },
  "license": "Apache-2.0"
}
